{
    "files.exclude": {
        "**/.DS_Store": true,
        "**/.git": true,
        "**/.vs": true,
        "**/Library": true,
        "**/library": true,
        "**/Temp": true,
        "**/temp": true,
        "**/Obj": true,
        "**/obj": true,
        "**/Logs": true,
        "**/logs": true,
        "**/UserSettings": true,
        "**/MemoryCaptures": true,
        "**/Build": true,
        "**/build": true,
        "**/Builds": true,
        "**/builds": true
    },
    "files.associations": {
        "*.asset": "yaml",
        "*.meta": "yaml",
        "*.prefab": "yaml",
        "*.unity": "yaml",
        "*.inputactions": "json"
    },
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.cs": "${capture}.cs.meta",
        "*.prefab": "${capture}.prefab.meta",
        "*.unity": "${capture}.unity.meta",
        "*.asset": "${capture}.asset.meta",
        "*.sln": "*.csproj",
        "*.slnx": "*.csproj"
    },
    "dotnet.defaultSolution": "unity-project.slnx"
}
